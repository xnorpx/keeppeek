{
	"name": "keeppeek-ui",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.14",
	"engines": {
		"bun": ">=1.3.14"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings --tsgo-experimental-api",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings --tsgo-experimental-api --watch",
		"lint": "oxlint .",
		"lint:fix": "oxlint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"registry:check": "bun scripts/check-public-registries.ts",
		"test:unit": "vitest",
		"test:unit:run": "vitest run",
		"test:unit:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:typecheck": "tsc --noEmit --project ./e2e/tsconfig.json",
		"test:e2e:install": "playwright install chromium",
		"test:e2e:ui": "playwright test --ui",
		"test": "bun run test:unit:run && bun run test:e2e",
		"quality": "bun run registry:check && bun run format:check && bun run lint && bun run check && bun run test:e2e:typecheck && bun run test:unit:run && bun run build"
	},
	"devDependencies": {
		"@bufbuild/buf": "^1.50.0",
		"@bufbuild/protoc-gen-es": "^2.2.3",
		"@internationalized/date": "3.12.3",
		"@lucide/svelte": "1.31.0",
		"@playwright/test": "1.62.1",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.70.2",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "26.2.0",
		"@typescript/native": "npm:typescript@7.0.2",
		"@vitest/browser-playwright": "4.1.10",
		"bits-ui": "2.18.1",
		"clsx": "2.1.1",
		"oxlint": "1.78.0",
		"playwright": "1.62.1",
		"prettier": "3.9.6",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"svelte": "5.56.9",
		"svelte-check": "4.7.6",
		"tailwind-merge": "3.6.0",
		"tailwind-variants": "3.3.1",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"vite": "8.2.1",
		"vitest": "4.1.10",
		"vitest-browser-svelte": "3.0.0"
	},
	"dependencies": {
		"@bufbuild/protobuf": "^2.2.3"
	},
	"//": "Temporary Rolldown pin: 1.2.5 was published without its Linux ARM64 binding. Remove with https://github.com/xnorpx/keeppeek/issues/82.",
	"overrides": {
		"rolldown": "1.2.4"
	}
}

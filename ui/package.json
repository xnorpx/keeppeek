{
	"name": "keeppeek-ui",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.14",
	"engines": {
		"bun": ">=1.3.14"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings --watch",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"registry:check": "bun scripts/check-public-registries.ts",
		"test:unit": "vitest",
		"test:unit:run": "vitest run",
		"test:unit:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:install": "playwright install chromium",
		"test:e2e:ui": "playwright test --ui",
		"test": "bun run test:unit:run && bun run test:e2e",
		"quality": "bun run registry:check && bun run format:check && bun run lint && bun run check && bun run test:unit:run && bun run build"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@internationalized/date": "3.11.0",
		"@lucide/svelte": "0.561.0",
		"@playwright/test": "1.62.1",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.53.0",
		"@sveltejs/vite-plugin-svelte": "5.1.1",
		"@tailwindcss/vite": "4.2.0",
		"@types/node": "24.13.3",
		"@vitest/browser-playwright": "4.1.10",
		"bits-ui": "2.16.2",
		"clsx": "2.1.1",
		"eslint": "10.8.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.22.0",
		"globals": "17.9.0",
		"playwright": "1.62.1",
		"prettier": "3.9.6",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"svelte": "5.53.2",
		"svelte-check": "4.7.5",
		"tailwind-merge": "3.5.0",
		"tailwind-variants": "3.2.2",
		"tailwindcss": "4.2.0",
		"tw-animate-css": "1.4.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.66.0",
		"vite": "6.4.1",
		"vitest": "4.1.10",
		"vitest-browser-svelte": "2.2.1"
	}
}
